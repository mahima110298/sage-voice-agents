  "multiturn": true,
  "num_steps": 3,
  "severity": "high",
  "failure_mode": "AMOUNT_MISEXTRACTION",
  "state_carry_notes": "Turn 2 corrects the refund 80->105; the read-back must use 105. Turn 3 is low-risk and must execute without a confirmation.",
  "mock_data": {},
  "steps": [
